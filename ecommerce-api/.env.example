# Entorno de ejecucion (development | production)
NODE_ENV=development

# Puerto donde escucha el servidor (en servicios como Render/Railway lo asigna el host automaticamente)
PORT=4000

# Origenes permitidos para CORS (la URL publica de tu frontend desplegado, ej. https://mi-tienda.vercel.app)
# Puedes colocar varias URLs separadas por coma
CORS_ORIGIN=http://localhost:3000

# Cadena de conexion a la base de datos (en produccion: MongoDB Atlas con usuario y password)
MONGODB_URI=mongodb://localhost:27017/ecommerce-db-test

# Claves secretas para firma de tokens JWT (generar con: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))")
JWT_SECRET=tu_clave_secreta_jwt_muy_segura
JWT_REFRESH_TOKEN=tu_clave_secreta_refresh_muy_segura
JWT_EXPIRES_IN=1h
JWT_REFRESH_EXPIRES_IN=7d

# Credenciales de Cloudinary (para subida de imagenes en /api/upload)
CLOUDINARY_CLOUD_NAME=tu_cloud_name
CLOUDINARY_API_KEY=tu_api_key
CLOUDINARY_API_SECRET=tu_api_secret
